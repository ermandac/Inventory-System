# Server Configuration
PORT=3000
HOST=0.0.0.0  # Listen on all network interfaces
NODE_ENV=production

# VPN Configuration
VPN_NETWORK_CIDR=10.0.0.0/24  # Your VPN network CIDR
ALLOWED_VPN_IPS=10.0.0.1,10.0.0.2  # Comma-separated list of allowed VPN IPs

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/inventory-system
MONGODB_HOST=mongodb
MONGODB_PORT=27017

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# Security Configuration
CORS_ORIGIN=*  # Be cautious with this in production
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# Email Configuration (for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@example.com
